# 伺服器部署的密鑰範本（docker-compose-server.yml 使用，SIT 與正式環境共用）
# 使用方式：在部署主機上複製成同目錄的 .env，填入實際值
#   cp .env.server.example .env && chmod 600 .env
# .env 含密碼與金鑰：不可提交到 git、不可傳給他人；每個環境（SIT、正式）都要各自重新產生，不可沿用其他環境的值
# 產生隨機值的指令都寫在各項上方，在部署主機上執行後把結果貼到等號後面

# ---- 資料庫 ----
# 資料庫分成兩個帳號（原因見 README.md「資料庫帳號」）：
# 1. 建表帳號：Flyway 建立、修改資料表時使用，是資料表擁有者（自訂名稱，例如 starter_owner）
APP_FLYWAY_USERNAME=
# 建表帳號的密碼：openssl rand -hex 24
APP_FLYWAY_PASSWORD=
# 2. 後端執行時使用的帳號，名稱固定為 starter_app（不用填），只需要設定密碼：openssl rand -hex 24
APP_DB_PASSWORD=
# 資料庫名稱（不填則為 starter）
APP_DB_NAME=starter

# ---- Redis ----
# Redis 密碼：openssl rand -hex 32
APP_REDIS_PASSWORD=

# ---- 後端 ----
# JWT 簽章金鑰：openssl rand -base64 32
APP_JWT_KEY=
# Jasypt 主密碼（application.yml 中 ENC(...) 設定值的解密密碼）
# 注意：資料庫帳密已由上方的 APP_FLYWAY_*／APP_DB_PASSWORD 直接提供，但 Jasypt 主密碼仍為必填，
# 產生方式：openssl rand -base64 24；說明見 doc/HOW_TO_ENCRYPT_STRING_IN_PROPERTIES.md
APP_JASYPT_PASSWORD=
# Java 記憶體設定（不填則為 -Xms64M -Xmx1024M）
APP_JAVA_OPTS=
# Spring profile。測試環境（SIT）可以填 local：建立示範租戶與 admin／tenant_a_user／tenant_b_user 三組固定密碼帳號（密碼在 git 裡，見 README）
# 正式環境必須留空：留空時不建立這些帳號，admin 第一次登入強制改密碼
APP_SPRING_PROFILES=

# ---- 前端 ----
# 加密登入 cookie 的金鑰：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# 更換後所有使用者需要重新登入
APP_FRONTEND_SECRET_KEY=
# 只允許以 HTTPS 傳送登入 cookie（不填則為 true）。設定好 HTTPS 後必須是 true；
# 只有在尚未設定 HTTPS、暫時以 http 測試時才改成 false，測試完要改回來
APP_COOKIE_SECURE=
# 登入頁的測試帳號快速登入按鈕。只給測試環境（且 APP_SPRING_PROFILES=local）：
# 填入 README「本機示範資料」三組帳號的密碼，登入頁就會出現「總管理員／示範租戶 A／示範租戶 B」按鈕，按一下就登入。
# 正式環境必須留空
APP_QUICK_LOGIN_ADMIN_PASSWORD=
APP_QUICK_LOGIN_TENANT_A_PASSWORD=
APP_QUICK_LOGIN_TENANT_B_PASSWORD=
